# --- Сборка (Build Variables в Coolify) ---
PUBLIC_YM_ID=            # номер счётчика Яндекс Метрики
PUBLIC_SMARTCAPTCHA_KEY= # ключ клиента Yandex SmartCaptcha

# --- Работа (Environment Variables в Coolify) ---
SMARTCAPTCHA_SERVER_KEY= # ключ сервера Yandex SmartCaptcha
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_USER=hello@reconcept.ru
SMTP_PASS=               # пароль приложения Яндекс 360
LEAD_TO=hello@reconcept.ru
TELEGRAM_BOT_TOKEN=      # необязательно: уведомление без персональных данных
TELEGRAM_CHAT_ID=
DATA_DIR=/data
