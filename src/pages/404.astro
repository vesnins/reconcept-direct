---
import Base from '../layouts/Base.astro';
---
<Base title="Страница не найдена — DIRECT.RECONCEPT" noindex>
  <div class="rule mono" aria-hidden="true">Ошибка 404</div>
  <main class="sec" style="padding-block:24px 64px">
    <h1>Такой страницы нет</h1>
    <p class="small" style="margin:16px 0 24px">Возможно, ссылка устарела.</p>
    <a class="btn solid" href="/">На главную</a>
  </main>
</Base>
